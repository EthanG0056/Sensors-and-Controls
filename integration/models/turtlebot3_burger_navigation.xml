<mujoco model="turtlebot3_burger">

  <!-- ============================================================ -->
  <!--                       COMPILER SETTINGS                      -->
  <!-- ============================================================ -->

  <compiler
    angle="radian"
    meshdir="../../simulation/robotis_tb3/assets/"
  />


  <!-- ============================================================ -->
  <!--                         ASSET SETUP                          -->
  <!-- ============================================================ -->

  <asset>

    <!-- Materials -->
    <material name="grey" rgba="0.3 0.3 0.3 1"/>
    <material name="black" rgba="0.1 0.1 0.1 1"/>

    <!-- Meshes -->
    <mesh name="burger_base" file="burger_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="left_tire" file="left_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="right_tire" file="right_tire.stl" scale="0.001 0.001 0.001"/>
    <mesh name="lds" file="lds.stl" scale="0.001 0.001 0.001"/>

  </asset>


  <!-- ============================================================ -->
  <!--                         DEFAULTS                             -->
  <!-- ============================================================ -->

  <default>

    <!-- Wheel Motor Settings -->
    <default class="wheel">
      <joint limited="false" frictionloss="0.1" armature="0.01"/>
      <velocity kv="1.0" ctrlrange="-6.67 6.67" ctrllimited="true"/>

      <!-- Left Wheel -->
      <default class="wheel_left">
        <joint axis="0 0 1"/>
      </default>

      <!-- Right Wheel -->
      <default class="wheel_right">
        <joint axis="0 0 1"/>
      </default>
    </default>

    <!-- Visual Geometry -->
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
    </default>

    <!-- Collision Geometry -->
    <default class="collision">
      <geom group="3" type="mesh"/>
    </default>

  </default>


  <!-- ============================================================ -->
  <!--                         ROBOT BODY                           -->
  <!-- ============================================================ -->

  <worldbody>

    <!-- ======================== BASE ======================== -->

    <body name="base" pos="0 0 0">

      <!-- Base Dynamics -->
      <inertial
        pos="-0.032 0 0.03"
        mass="0.9"
        diaginertia="0.005 0.005 0.003"
      />

      <joint type="free" name="base_joint"/>

      <!-- Base Visual and Collision Geometry -->
      <geom
        pos="-0.032 0 0.01"
        mesh="burger_base"
        material="black"
        class="visual"
      />

      <geom
        pos="-0.032 0 0.01"
        mesh="burger_base"
        class="collision"
      />

      <!-- Rear Support / Caster Contact -->
      <geom
        size="0.005"
        pos="-0.081 0 0.005"
        type="sphere"
        material="grey"
        friction="0.0001 0.0001 0.0001"
        solref="0.02 1"
        solimp="0.95 0.99 0.001"
        condim="1"
      />

      <!-- LDS Visual Model -->
      <geom
        pos="-0.032 0 0.182"
        mesh="lds"
        material="black"
        class="visual"
      />

      <geom
        pos="-0.032 0 0.182"
        mesh="lds"
        class="collision"
      />

      <!-- ======================= LIDAR ======================= -->

      <body name="lidar_body" pos="0 0 0.18">

        <site name="lidar_00" pos="0 0 0" euler="0 1.570796 0.000000"/>
        <site name="lidar_01" pos="0 0 0" euler="0 1.570796 0.174533"/>
        <site name="lidar_02" pos="0 0 0" euler="0 1.570796 0.349066"/>
        <site name="lidar_03" pos="0 0 0" euler="0 1.570796 0.523599"/>
        <site name="lidar_04" pos="0 0 0" euler="0 1.570796 0.698132"/>
        <site name="lidar_05" pos="0 0 0" euler="0 1.570796 0.872665"/>
        <site name="lidar_06" pos="0 0 0" euler="0 1.570796 1.047198"/>
        <site name="lidar_07" pos="0 0 0" euler="0 1.570796 1.221730"/>
        <site name="lidar_08" pos="0 0 0" euler="0 1.570796 1.396263"/>
        <site name="lidar_09" pos="0 0 0" euler="0 1.570796 1.570796"/>
        <site name="lidar_10" pos="0 0 0" euler="0 1.570796 1.745329"/>
        <site name="lidar_11" pos="0 0 0" euler="0 1.570796 1.919862"/>
        <site name="lidar_12" pos="0 0 0" euler="0 1.570796 2.094395"/>
        <site name="lidar_13" pos="0 0 0" euler="0 1.570796 2.268928"/>
        <site name="lidar_14" pos="0 0 0" euler="0 1.570796 2.443461"/>
        <site name="lidar_15" pos="0 0 0" euler="0 1.570796 2.617994"/>
        <site name="lidar_16" pos="0 0 0" euler="0 1.570796 2.792527"/>
        <site name="lidar_17" pos="0 0 0" euler="0 1.570796 2.967060"/>
        <site name="lidar_18" pos="0 0 0" euler="0 1.570796 3.141593"/>
        <site name="lidar_19" pos="0 0 0" euler="0 1.570796 3.316126"/>
        <site name="lidar_20" pos="0 0 0" euler="0 1.570796 3.490659"/>
        <site name="lidar_21" pos="0 0 0" euler="0 1.570796 3.665191"/>
        <site name="lidar_22" pos="0 0 0" euler="0 1.570796 3.839724"/>
        <site name="lidar_23" pos="0 0 0" euler="0 1.570796 4.014257"/>
        <site name="lidar_24" pos="0 0 0" euler="0 1.570796 4.188790"/>
        <site name="lidar_25" pos="0 0 0" euler="0 1.570796 4.363323"/>
        <site name="lidar_26" pos="0 0 0" euler="0 1.570796 4.537856"/>
        <site name="lidar_27" pos="0 0 0" euler="0 1.570796 4.712389"/>
        <site name="lidar_28" pos="0 0 0" euler="0 1.570796 4.886922"/>
        <site name="lidar_29" pos="0 0 0" euler="0 1.570796 5.061455"/>
        <site name="lidar_30" pos="0 0 0" euler="0 1.570796 5.235988"/>
        <site name="lidar_31" pos="0 0 0" euler="0 1.570796 5.410521"/>
        <site name="lidar_32" pos="0 0 0" euler="0 1.570796 5.585054"/>
        <site name="lidar_33" pos="0 0 0" euler="0 1.570796 5.759587"/>
        <site name="lidar_34" pos="0 0 0" euler="0 1.570796 5.934119"/>
        <site name="lidar_35" pos="0 0 0" euler="0 1.570796 6.108652"/>

      </body>

      <!-- ==================== FRONT CAMERA ==================== -->

      <!-- Camera used for ArUco marker detection -->
      <camera
        name="front_camera"
        pos="0.05 0 0.12"
        quat="0.5 0.5 -0.5 -0.5"
        fovy="60"
      />


      <!-- ====================== LEFT WHEEL ====================== -->

      <body
        name="wheel_left"
        pos="0 0.08 0.033"
        quat="0.707388 -0.706825 0 0"
      >

        <inertial
          pos="0 0 0"
          quat="-0.000890159 0.706886 0.000889646 0.707326"
          mass="0.0284989"
          diaginertia="2.07126e-05 1.11924e-05 1.11756e-05"
        />

        <joint name="wheel_left" class="wheel_left"/>

        <geom
          quat="0.707388 0.706825 0 0"
          mesh="left_tire"
          material="grey"
          class="visual"
        />

        <geom
          quat="0.707388 0.706825 0 0"
          mesh="left_tire"
          class="collision"
        />

      </body>


      <!-- ===================== RIGHT WHEEL ===================== -->

      <body
        name="wheel_right"
        pos="0 -0.08 0.033"
        quat="0.707388 -0.706825 0 0"
      >

        <inertial
          pos="0 0 0"
          quat="-0.000890159 0.706886 0.000889646 0.707326"
          mass="0.0284989"
          diaginertia="2.07126e-05 1.11924e-05 1.11756e-05"
        />

        <joint name="wheel_right" class="wheel_right"/>

        <geom
          quat="0.707388 0.706825 0 0"
          mesh="right_tire"
          material="grey"
          class="visual"
        />

        <geom
          quat="0.707388 0.706825 0 0"
          mesh="right_tire"
          class="collision"
        />

      </body>

    </body>
  </worldbody>


  <!-- ============================================================ -->
  <!--                         ACTUATORS                            -->
  <!-- ============================================================ -->

  <actuator>

    <velocity
      class="wheel_left"
      name="wheel_left"
      joint="wheel_left"
    />

    <velocity
      class="wheel_right"
      name="wheel_right"
      joint="wheel_right"
    />

  </actuator>


  <!-- ====================================================== -->
  <!-- LIDAR SENSORS                                          -->
  <!-- ====================================================== -->

  <sensor>

    <rangefinder name="lidar_00_sensor" site="lidar_00"/>
    <rangefinder name="lidar_01_sensor" site="lidar_01"/>
    <rangefinder name="lidar_02_sensor" site="lidar_02"/>
    <rangefinder name="lidar_03_sensor" site="lidar_03"/>
    <rangefinder name="lidar_04_sensor" site="lidar_04"/>
    <rangefinder name="lidar_05_sensor" site="lidar_05"/>
    <rangefinder name="lidar_06_sensor" site="lidar_06"/>
    <rangefinder name="lidar_07_sensor" site="lidar_07"/>
    <rangefinder name="lidar_08_sensor" site="lidar_08"/>
    <rangefinder name="lidar_09_sensor" site="lidar_09"/>
    <rangefinder name="lidar_10_sensor" site="lidar_10"/>
    <rangefinder name="lidar_11_sensor" site="lidar_11"/>
    <rangefinder name="lidar_12_sensor" site="lidar_12"/>
    <rangefinder name="lidar_13_sensor" site="lidar_13"/>
    <rangefinder name="lidar_14_sensor" site="lidar_14"/>
    <rangefinder name="lidar_15_sensor" site="lidar_15"/>
    <rangefinder name="lidar_16_sensor" site="lidar_16"/>
    <rangefinder name="lidar_17_sensor" site="lidar_17"/>
    <rangefinder name="lidar_18_sensor" site="lidar_18"/>
    <rangefinder name="lidar_19_sensor" site="lidar_19"/>
    <rangefinder name="lidar_20_sensor" site="lidar_20"/>
    <rangefinder name="lidar_21_sensor" site="lidar_21"/>
    <rangefinder name="lidar_22_sensor" site="lidar_22"/>
    <rangefinder name="lidar_23_sensor" site="lidar_23"/>
    <rangefinder name="lidar_24_sensor" site="lidar_24"/>
    <rangefinder name="lidar_25_sensor" site="lidar_25"/>
    <rangefinder name="lidar_26_sensor" site="lidar_26"/>
    <rangefinder name="lidar_27_sensor" site="lidar_27"/>
    <rangefinder name="lidar_28_sensor" site="lidar_28"/>
    <rangefinder name="lidar_29_sensor" site="lidar_29"/>
    <rangefinder name="lidar_30_sensor" site="lidar_30"/>
    <rangefinder name="lidar_31_sensor" site="lidar_31"/>
    <rangefinder name="lidar_32_sensor" site="lidar_32"/>
    <rangefinder name="lidar_33_sensor" site="lidar_33"/>
    <rangefinder name="lidar_34_sensor" site="lidar_34"/>
    <rangefinder name="lidar_35_sensor" site="lidar_35"/>

  <!-- Continue to lidar_35_sensor -->

  </sensor>


  <!-- ============================================================ -->
  <!--                     CONTACT EXCLUSIONS                       -->
  <!-- ============================================================ -->

  <contact>
    <exclude body1="base" body2="wheel_left"/>
    <exclude body1="base" body2="wheel_right"/>
  </contact>

</mujoco>