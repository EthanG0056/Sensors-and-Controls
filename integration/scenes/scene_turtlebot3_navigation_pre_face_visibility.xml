<mujoco model="TB3 Burger Navigation Scene">

  <!-- ============================================================ -->
  <!--                         ROBOT MODEL                          -->
  <!-- ============================================================ -->

  <include file="../models/turtlebot3_burger_navigation.xml"/>


  <!-- ============================================================ -->
  <!--                       SCENE SETTINGS                         -->
  <!-- ============================================================ -->

  <statistic center="1.5 0 0.4" extent="2.5"/>

  <visual>

    <headlight
      diffuse="0.6 0.6 0.6"
      ambient="0.3 0.3 0.3"
      specular="0 0 0"
    />

    <rgba haze="0.15 0.25 0.35 1"/>

    <global
      azimuth="120"
      elevation="-20"
      offwidth="640"
      offheight="480"
    />

  </visual>


  <!-- ============================================================ -->
  <!--                           ASSETS                             -->
  <!-- ============================================================ -->

  <asset>

    <!-- Sky -->
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"
    />

    <!-- Ground -->
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.30 0.30 0.32"
      rgb2="0.42 0.42 0.45"
      markrgb="0.65 0.65 0.68"
      width="300"
      height="300"
    />

    <material
      name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="8 8"
      reflectance="0.05"
    />

    <!-- ArUco Marker 0 Texture -->
    <texture
      name="aruco_texture_0"
      type="2d"
      file="../assets/aruco_0.png"
    />

    <material
      name="aruco_material_0"
      texture="aruco_texture_0"
      texrepeat="1 1"
      texuniform="false"
    />

    <!-- ArUco Marker 1 Texture -->
    <texture
      name="aruco_texture_1"
      type="2d"
      file="../assets/aruco_1.png"
    />

    <material
      name="aruco_material_1"
      texture="aruco_texture_1"
      texrepeat="1 1"
      texuniform="false"
    />

  </asset>


  <!-- ============================================================ -->
  <!--                           WORLD                              -->
  <!-- ============================================================ -->

  <worldbody>

    <!-- Lighting -->
    <light
      pos="0 0 2"
      dir="0 0 -1"
      directional="true"
    />

    <!-- Floor -->
    <geom
      name="floor"
      size="0 0 0.05"
      type="plane"
      material="groundplane"
    />


    <!-- ======================================================== -->
    <!--                         ROOM WALLS                       -->
    <!-- ======================================================== -->

    <!-- Rear wall -->
    <geom
      name="rear_wall"
      type="box"
      pos="-0.40 0 0.30"
      size="0.05 1.50 0.30"
      rgba="0.82 0.82 0.84 1"
    />

    <!-- Left wall -->
    <geom
      name="left_wall"
      type="box"
      pos="1.20 1.50 0.30"
      size="1.60 0.05 0.30"
      rgba="0.82 0.82 0.84 1"
    />

    <!-- Right wall -->
    <geom
      name="right_wall"
      type="box"
      pos="1.20 -1.10 0.30"
      size="1.60 0.05 0.30"
      rgba="0.82 0.82 0.84 1"
    />

    <!-- Far wall -->
    <geom
      name="front_wall"
      type="box"
      pos="2.80 0 0.30"
      size="0.05 1.50 0.30"
      rgba="0.82 0.82 0.84 1"
    />


    <!-- ======================================================== -->
    <!--                    CHARGING STATION                      -->
    <!-- ======================================================== -->

    <body name="charging_station" pos="2.68 0.4 0">

      <!-- Station body -->
      <geom
        name="charging_station_body"
        type="box"
        pos="0 0 0.15"
        size="0.05 0.18 0.15"
        rgba="0.25 0.25 0.25 1"
      />

      <!-- Charging pad -->
      <geom
        name="charging_pad"
        type="box"
        pos="-0.22 0 0.006"
        size="0.16 0.18 0.006"
        rgba="0.10 0.35 0.15 1"
        contype="0"
        conaffinity="0"
      />

      <!-- ArUco marker -->
      <geom
        name="aruco_marker"
        type="box"
        pos="-0.056 0 0.15"
        size="0.005 0.10 0.10"
        material="aruco_material_0"
        contype="0"
        conaffinity="0"
      />

    </body>


    <!-- ======================================================== -->
    <!--                         OBSTACLE                         -->
    <!-- ======================================================== -->

    <!-- Obstacle 1 -->
    <geom
      name="obstacle_1"
      type="box"
      pos="0.6 0.15 0.15"
      size="0.075 0.075 0.15"
      rgba="0.75 0.20 0.20 1"
    />

    <!-- Obstacle 2 with relative ArUco marker -->
    <body
      name="obstacle_2_body"
      pos="1.35 -0.2 0"
    >

      <!-- Obstacle 2 -->
      <geom
        name="obstacle_2"
        type="box"
        pos="0 0 0.15"
        size="0.12 0.12 0.15"
        rgba="0.80 0.45 0.15 1"
      />

      <!-- ArUco marker 1 -->
      <geom
        name="aruco_marker_1"
        type="box"
        pos="-0.135 0 0.20"
        size="0.005 0.10 0.10"
        material="aruco_material_1"
        contype="0"
        conaffinity="0"
      />

    </body>


  </worldbody>

</mujoco>