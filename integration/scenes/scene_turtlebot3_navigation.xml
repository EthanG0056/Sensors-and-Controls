<mujoco model="TB3 Burger Navigation Scene">

  <!-- ============================================================ -->
  <!--                         ROBOT MODEL                          -->
  <!-- ============================================================ -->

  <include file="../models/turtlebot3_burger_navigation.xml"/>


  <!-- ============================================================ -->
  <!--                       SCENE SETTINGS                         -->
  <!-- ============================================================ -->

  <statistic center="0.8 0 0.4" extent="2"/>

  <visual>

    <headlight
      diffuse="0.6 0.6 0.6"
      ambient="0.3 0.3 0.3"
      specular="0 0 0"
    />

    <rgba haze="0.15 0.25 0.35 1"/>

    <global
      azimuth="120"
      elevation="-20"
      offwidth="640"
      offheight="480"
    />

  </visual>


  <!-- ============================================================ -->
  <!--                           ASSETS                             -->
  <!-- ============================================================ -->

  <asset>

    <!-- Sky -->
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"
    />

    <!-- Ground -->
    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"
    />

    <material
      name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"
    />

    <!-- ArUco Marker Texture -->
    <texture
      name="aruco_texture"
      type="2d"
      file="../assets/aruco_0.png"
    />

    <material
      name="aruco_material"
      texture="aruco_texture"
      texrepeat="1 1"
      texuniform="false"
    />

  </asset>


  <!-- ============================================================ -->
  <!--                           WORLD                              -->
  <!-- ============================================================ -->

  <worldbody>

    <!-- Lighting -->
    <light
      pos="0 0 2"
      dir="0 0 -1"
      directional="true"
    />

    <!-- Floor -->
    <geom
      name="floor"
      size="0 0 0.05"
      type="plane"
      material="groundplane"
    />


    <!-- ======================================================== -->
    <!--                    CHARGING STATION                      -->
    <!-- ======================================================== -->

    <body name="charging_station" pos="2.0 0 0">

      <!-- Station body -->
      <geom
        name="charging_station_body"
        type="box"
        pos="0 0 0.15"
        size="0.05 0.18 0.15"
        rgba="0.25 0.25 0.25 1"
      />

      <!-- ArUco marker -->
      <geom
        name="aruco_marker"
        type="box"
        pos="-0.056 0 0.15"
        size="0.005 0.10 0.10"
        material="aruco_material"
        contype="0"
        conaffinity="0"
      />

    </body>

    <!-- ======================================================== -->
    <!--                         OBSTACLE                         -->
    <!-- ======================================================== -->

    <geom
      name="test_obstacle"
      type="box"
      pos="0.7 0.3 0.15"
      size="0.15 0.15 0.15"
      rgba="0.8 0.2 0.2 1"
    />

  </worldbody>

</mujoco>